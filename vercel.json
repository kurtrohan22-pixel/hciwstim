{
    "version": 2,
    "installCommand": "rm -rf bootstrap/cache && composer install --no-dev --no-interaction --prefer-dist",
    "buildCommand": "rm -rf bootstrap/cache && npm run build",
    "outputDirectory": "public/build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
